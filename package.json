{
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm turbo build",
    "check": "node scripts/check.mjs",
    "check:boundaries": "node scripts/check-dependency-boundaries.mjs",
    "commit": "lint-staged && git-cz",
    "dev": "lerna run --parallel dev",
    "fix": "eslint --debug --fix packages || true && prettier --write \"packages/**/*\"",
    "lint": "eslint ./packages",
    "lint:debug": "eslint --debug ./packages",
    "test": "FORCE_COLOR=1 vitest run --coverage $VITEST_EXTRA_OPTS",
    "test:storybook": "pnpm --filter @repo/storybook-config test:storybook",
    "typecheck": "pnpm build",
    "turbo": "TURBO_TELEMETRY_DISABLED=1 FORCE_COLOR=1 turbo --cache-dir ./.turbo-cache --color",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@fuf-stack/eslint-config-fuf": "2.1.0",
    "@fuf-stack/project-cli-tools": "1.0.24",
    "@fuf-stack/typescript-config": "0.6.0",
    "@fuf-stack/vitest-config": "5.0.8",
    "@lerna-lite/cli": "5.6.2",
    "@repo/storybook-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/tsdown-config": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@types/node": "24.19.2",
    "color2k": "2.0.4",
    "jsdom": "30.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "workspaces": [
    "packages/*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-pnpm-scopes"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
