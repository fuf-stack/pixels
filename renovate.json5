{
  // validate with (see: https://docs.renovatebot.com/config-validation/):
  // npx --yes --package renovate -- renovate-config-validator renovate.json5 --strict

  dependencyDashboard: {
    labels: ['effort | ongoing', 'scope | dependencies'],
    osvVulnerabilitySummary: 'all',
  },
  extends: [
    // Includes recommended defaults and GitHub Action SHA pinning.
    'config:best-practices',
    // Pin action digests with exact versions (# v6.1.1, not # v6). Tag-only
    // pins make every update a digest update without a release timestamp, so
    // the minimumReleaseAge status never passes and automerge never runs.
    // see: https://docs.renovatebot.com/presets-helpers/#helperspingithubactiondigeststosemver
    'helpers:pinGitHubActionDigestsToSemver',
    ':automergeDigest',
    ':automergeMinor',
    ':combinePatchMinorReleases',
    ':dependencyDashboard',
    ':docker',
    ':enableVulnerabilityAlertsWithLabel(renovate | alert)',
    ':maintainLockFilesWeekly',
    ':prHourlyLimit4',
  ],
  ignorePaths: ['/node_modules/'],
  // Wait 14 days to match pnpm, except for @fuf-stack packages below.
  // see: https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  minimumReleaseAge: '14 days',
  // Exclude releases until the age requirement passes, then create PRs
  // immediately rather than waiting for branch checks.
  internalChecksFilter: 'strict',
  prCreation: 'immediate',
  // Also create security PRs from osv.dev data, independent of whether
  // GitHub Dependabot alerts are enabled and readable by the Renovate app.
  // Vulnerability fixes skip minimumReleaseAge and the schedule; fixes younger
  // than 14 days still need a minimumReleaseAgeExclude in pnpm-workspace.yaml.
  // see: https://docs.renovatebot.com/configuration-options/#osvvulnerabilityalerts
  osvVulnerabilityAlerts: true,
  // Commit security updates as fix, also for dev dependencies (otherwise
  // chore), so release-please lists them in the changelog. Applies to OSV and
  // GitHub alert PRs and merges with the label from the preset above.
  // see: https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts
  vulnerabilityAlerts: {
    semanticCommitType: 'fix',
  },
  // see: https://docs.renovatebot.com/configuration-options/#prconcurrentlimit
  prConcurrentLimit: 20,
  // only rebase merge requests when they become conflicted
  // see: https://docs.renovatebot.com/configuration-options/#rebasewhen
  rebaseWhen: 'conflicted',
  // https://docs.renovatebot.com/configuration-options/#stopupdatinglabel
  stopUpdatingLabel: 'renovate | stop update',
  // Mend jobs have 3 GiB total; leave room for Renovate alongside pnpm.
  // https://docs.renovatebot.com/mend-hosted/faq/#im-hitting-a-timeout-kernel-out-of-memory-limit-with-a-pnpmyarn-project
  toolSettings: {
    nodeMaxMemory: 1024,
  },
  packageRules: [
    // Preserve our 14-day npm delay and immediate PR creation over the
    // shorter release age and branch-check defaults in best-practices.
    {
      matchManagers: ['npm'],
      minimumReleaseAge: '14 days',
      prCreation: 'immediate',
    },

    // Lock file maintenance has no release age; pnpm still enforces its own
    // minimumReleaseAge when it rewrites the lockfile. Keep after the npm rule.
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      minimumReleaseAge: null,
    },

    // @dnd-kit monorepo
    {
      matchPackageNames: ['/^@dnd-kit/'],
      groupName: '@dnd-kit monorepo',
    },

    // @fuf-stack packages: skip minimumReleaseAge (fuf packages)
    {
      matchPackageNames: ['/^@fuf-stack/'],
      minimumReleaseAge: null,
    },

    // @heroui monorepo
    {
      matchPackageNames: ['/^@heroui/'],
      groupName: '@heroui monorepo',
    },

    // framer-motion: weekly only (rate-limiting)
    {
      matchPackageNames: ['framer-motion'],
      schedule: ['before 9am on monday'],
    },
  ],
}
