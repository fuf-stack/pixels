          data-required="true"
          data-slot="base"
          for="«replaced-aria-id»-control"
        >
          <span
            style="border: 0px; clip: rect(0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap;"
          >
            <input
              aria-describedby="delivery-description"
              aria-labelledby="«replaced-aria-id»-label"
              data-react-aria-pressable="true"
              id="«replaced-aria-id»-control"
              name="delivery"
              tabindex="-1"
              type="radio"
              value="post"
            />
          </span>
          <span
            aria-hidden="true"
            class="relative box-border inline-flex h-5 w-5 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-solid border-default transition-transform-colors group-data-[pressed=true]:scale-95 group-data-[invalid=true]:border-danger group-data-[invalid=true]:group-data-[selected=true]:border-danger group-data-[selected=true]:border-primary group-data-[hover-unselected=true]:bg-default-100 group-data-[focus-visible=true]:ring-2 group-data-[focus-visible=true]:ring-focus group-data-[focus-visible=true]:ring-offset-2 group-data-[focus-visible=true]:ring-offset-background motion-reduce:transition-none"
            data-slot="wrapper"
          >
            <span
              class="z-10 h-2 w-2 origin-center scale-0 rounded-full bg-primary text-primary-foreground opacity-0 transition-transform-opacity group-data-[selected=true]:scale-100 group-data-[invalid=true]:bg-danger group-data-[invalid=true]:text-danger-foreground group-data-[selected=true]:opacity-100 motion-reduce:transition-none"
              data-slot="control"
            />
          </span>
          <div
            class="ml-1 ms-2 flex flex-col"
            data-slot="label-wrapper"
          >
            <span
              class="relative select-none text-foreground transition-colors text-medium motion-reduce:transition-none"
              data-slot="label"
              id="«replaced-aria-id»-label"
            >
              Post
            </span>
          </div>
        </label>
      </div>
    </div>
    <div
      data-slot="helper-wrapper"
    >
      <div
        class="text-foreground-400 text-tiny"
        data-slot="description"
        id="delivery-description"
      >
        Choose a delivery method
      </div>
    </div>
  </div>
</div>
`;
