// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Story Snapshots > CustomStyling 1`] = `
<div>
  <div
    class="flex flex-col gap-1"
  >
    <label
      for="email"
    >
      Email
      <input
        aria-describedby="email-error"
        aria-invalid="true"
        id="email"
      />
    </label>
    <div
      class="rounded-small bg-danger-50 p-2 text-danger"
      data-slot="error-message"
      id="email-error"
    >
      <ul
        aria-label="Validation errors of field email"
        class="list-disc ps-5"
        data-testid="email_error"
      >
        <li
          class="font-semibold"
          style="overflow: hidden;"
        >
          <div
            class="pt-1 px-0"
          >
            Email is required
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>
`;

