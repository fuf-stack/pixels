          id="react-aria-«replaced-aria-id»"
          tabindex="0"
          type="submit"
        >
          Submit
        </button>
      </div>
      <div
        class="relative box-border flex h-auto w-full flex-col overflow-hidden rounded-small border border-divider bg-content1 text-foreground shadow-none outline-solid outline-transparent data-[focus-visible=true]:z-10 data-[focus-visible=true]:outline-2 data-[focus-visible=true]:outline-offset-2 data-[focus-visible=true]:outline-focus transition-transform-background motion-reduce:transition-none mt-6"
        data-component="card"
        data-slot="base"
        tabindex="-1"
      >
        <div
          class="color-inherit overflow-inherit z-auto flex w-full shrink-0 items-center justify-start rounded-t-small p-3 text-base font-semibold subpixel-antialiased"
          data-slot="header"
        >
          Form State
        </div>
        <hr
          class="my-0 h-divider w-full shrink-0 border-none border-divider bg-divider"
        />
        <div
          class="relative flex h-auto w-full flex-auto flex-col p-3 place-content-inherit align-items-inherit overflow-y-auto break-words text-left subpixel-antialiased"
          data-slot="body"
        >
          <dl
            class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-small"
          >
            <dt
              class="text-default-500"
            >
              isValid
            </dt>
            <dd
              class="text-right font-mono"
              data-testid="state_is_valid"
            >
              false
            </dd>
            <dt
              class="text-default-500"
            >
              isSubmitting
            </dt>
            <dd
              class="text-right font-mono"
              data-testid="state_is_submitting"
            >
              false
            </dd>
            <dt
              class="text-default-500"
            >
              isSubmitSuccessful
            </dt>
            <dd
              class="text-right font-mono"
              data-testid="state_is_submit_successful"
            >
              false
            </dd>
            <dt
              class="text-default-500"
            >
              submitCount
            </dt>
            <dd
              class="text-right font-mono"
              data-testid="state_submit_count"
            >
              1
            </dd>
          </dl>
        </div>
      </div>
    </form>
  </div>
</div>
`;
