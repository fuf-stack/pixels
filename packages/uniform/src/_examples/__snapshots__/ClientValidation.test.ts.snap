            class="block cursor-default pb-1 text-small text-foreground group-data-[invalid=true]:text-danger"
            data-slot="label"
            for="uniform-«replaced-aria-id»"
            id="uniform-«replaced-aria-id»-label"
          >
            Email
            <span
              aria-hidden="true"
              class="ml-0.5 text-danger"
            >
              *
            </span>
          </label>
          <div
            class="relative inline-flex h-10 min-h-10 w-full cursor-text items-center shadow-xs rounded-small border-medium border-default-200 bg-content1 px-3 text-foreground transition-colors group-data-[disabled=true]:pointer-events-none group-data-[focus=true]:border-focus group-data-[invalid=true]:border-danger data-[hovered=true]:border-default-400 group-data-[focus=true]:data-[hovered=true]:border-default-foreground motion-reduce:transition-none is-filled"
            data-rac=""
            data-slot="input-wrapper"
            role="presentation"
          >
            <div
              class="inline-flex h-full w-full items-center gap-0"
              data-slot="inner-wrapper"
            >
              <input
                aria-labelledby="uniform-«replaced-aria-id»-label"
                aria-required="true"
                autocomplete="off"
                class="w-full min-w-0 bg-transparent bg-clip-text text-small font-normal text-inherit outline-none placeholder:text-foreground-500 autofill:bg-transparent data-[has-end-content=true]:pe-1.5 data-[has-start-content=true]:ps-1.5 dark:autofill:[-webkit-text-fill-color:var(--pixel-color-foreground)] [&::-ms-reveal]:hidden is-filled"
                data-filled="true"
                data-rac=""
                data-slot="input"
                data-testid="email"
                id="uniform-«replaced-aria-id»"
                name="email"
                placeholder="Enter email"
                tabindex="0"
                type="text"
                value="john@example.com"
              />
            </div>
          </div>
        </div>
        <div
          class="rounded bg-default-50 p-3 text-sm"
        >
          <strong
            class="mr-2"
          >
            Client Validation:
          </strong>
          ❌ Inactive
          <br />
          <small
            class="mt-1 block text-default-600"
          >
            Try typing an existing username to see validation errors!
          </small>
        </div>
      </div>
      <div
        class="mt-6"
      >
        <button
          aria-label="Submit form"
          class="group tap-highlight-transparent data-[hover=true]:opacity-hover group relative z-0 box-border inline-flex items-center justify-center select-none appearance-none whitespace-nowrap font-normal subpixel-antialiased transform-gpu cursor-pointer overflow-hidden tap-highlight-transparent data-[pressed=true]:scale-[0.97] outline-solid outline-transparent data-[focus-visible=true]:z-10 data-[focus-visible=true]:outline-2 data-[focus-visible=true]:outline-offset-2 data-[focus-visible=true]:outline-focus h-10 min-w-20 gap-2 rounded-medium px-4 text-small [&>svg]:max-w-[theme(spacing.8)] transition-transform-colors-opacity motion-reduce:transition-none bg-success text-white data-[hover=true]:opacity-hover"
          data-rac=""
          data-react-aria-pressable="true"
          data-testid="form_submit_button"
          id="react-aria-«replaced-aria-id»"
          tabindex="0"
          type="submit"
        >
          Submit
        </button>
      </div>
    </form>
  </div>
</div>
`;
