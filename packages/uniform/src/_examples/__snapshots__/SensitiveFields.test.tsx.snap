                          class="w-rjv-line"
                        >
                          <span>
                            <span
                              class="w-rjv-quotes"
                              data-placement="left"
                              style="color: var(--w-rjv-quotes-color, #236a7c);"
                            >
                              "
                            </span>
                            <span
                              class="w-rjv-object-key"
                              style="color: var(--w-rjv-key-string, #002b36);"
                            >
                              submitCount
                            </span>
                            <span
                              class="w-rjv-quotes"
                              data-placement="right"
                              style="color: var(--w-rjv-quotes-color, #236a7c);"
                            >
                              "
                            </span>
                          </span>
                          <span
                            class="w-rjv-colon"
                            style="color: var(--w-rjv-colon-color, var(--w-rjv-color)); margin-left: 0px; margin-right: 2px;"
                          >
                            :
                          </span>
                          <span
                            class="w-rjv-value"
                            data-type="int"
                            style="color: var(--w-rjv-type-int-color, #268bd2);"
                          >
                            0
                          </span>
                        </div>
                      </div>
                      <div
                        style="padding-left: 4px;"
                      >
                        <span
                          class="w-rjv-curlybraces-end"
                          style="color: var(--w-rjv-curlybraces-color, #236a7c);"
                        >
                          }
                        </span>
                      </div>
                    </div>
                  </div>
                  <div
                    style="padding-left: 4px;"
                  >
                    <span
                      class="w-rjv-curlybraces-end"
                      style="color: var(--w-rjv-curlybraces-color, #236a7c);"
                    >
                      }
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
