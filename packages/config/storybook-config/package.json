{
  "name": "@repo/storybook-config",
  "description": "shared storybook config",
  "private": true,
  "type": "module",
  "main": "./main.ts",
  "scripts": {
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=true storybook dev -p 6006",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=true storybook build --quiet",
    "test:storybook": "vitest run --config vitest.config.ts --project=storybook --maxWorkers=4"
  },
  "devDependencies": {
    "@repo/tailwind-config": "workspace:*",
    "@repo/vite-config": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "@vueless/storybook-dark-mode": "10.0.8",
    "playwright": "1.64.1",
    "storybook": "10.6.2"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
