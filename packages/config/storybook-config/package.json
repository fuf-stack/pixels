    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "@vueless/storybook-dark-mode": "10.0.8",
    "playwright": "1.62.1",
